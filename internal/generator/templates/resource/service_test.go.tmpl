type failingStore struct{*MemoryStore}
var failure=errors.New("storage unavailable")
func(failingStore)Create(context.Context,Record)(Record,error){return Record{},failure}
func(failingStore)List(context.Context,int,int)([]Record,error){return nil,failure}
func(failingStore)Patch(context.Context,int64,Input)(Record,error){return Record{},failure}
func TestStorageErrors(t *testing.T){s:=NewService(failingStore{NewMemoryStore()});if _,err:=s.Create(context.Background(),sampleInput());!errors.Is(err,failure){t.Fatal("lost create error",err)};if _,err:=s.List(context.Background(),20,0);!errors.Is(err,failure){t.Fatal("lost list error",err)};if _,err:=s.Patch(context.Background(),1,zeroInput());!errors.Is(err,failure){t.Fatal("lost patch error",err)}}

func TestConcurrentMemoryStore(t *testing.T){store:=NewMemoryStore();var workers sync.WaitGroup;for i:=0;i<50;i++{workers.Add(1);go func(){defer workers.Done();if _,err:=store.Create(context.Background(),sampleInput().Record());err!=nil{t.Error(err)}}()};workers.Wait();records,err:=store.List(context.Background(),100,0);if err!=nil||len(records)!=50{t.Fatalf("concurrent creates: %d %v",len(records),err)}}