package server

import (
 "bytes"
 "encoding/json"
 "io"
 "net/http/httptest"
 "os"
 "testing"
 "time"
 "{{.Module}}/internal/config"
)

func TestOpenAPIEndpoint(t *testing.T) {
 srv := New(config.Config{WriteTimeout: time.Second}, Dependencies{})
 req := httptest.NewRequest("GET", "/openapi.json", nil)
{{if eq .HTTP "fiber"}} resp, err := srv.App.Test(req)
 if err != nil { t.Fatal(err) }
{{else}} w := httptest.NewRecorder()
 srv.HTTP.Handler.ServeHTTP(w, req)
 resp := w.Result()
{{end}} defer resp.Body.Close()
 body, err := io.ReadAll(resp.Body)
 if err != nil { t.Fatal(err) }
 if resp.StatusCode != 200 || resp.Header.Get("Content-Type") != "application/json" {
  t.Fatalf("status=%d content-type=%q body=%s", resp.StatusCode, resp.Header.Get("Content-Type"), body)
 }
 var doc struct { OpenAPI string `json:"openapi"` }
 if err := json.Unmarshal(body, &doc); err != nil || doc.OpenAPI != "3.0.3" {
  t.Fatalf("invalid OpenAPI document: %s (%v)", body, err)
 }
 disk, err := os.ReadFile("../../openapi.json")
 if err != nil { t.Fatal(err) }
 if !bytes.Equal(bytes.TrimSpace(body), bytes.TrimSpace(disk)) {
  t.Fatal("served document differs from openapi.json")
 }
}
